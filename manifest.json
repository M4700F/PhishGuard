{
  "manifest_version": 3,
  "name": "PhishGuard \u2014 Real-Time Phishing Detector",
  "version": "1.0.0",
  "description": "Flags lookalike domains, suspicious redirect chains, and forms/scripts that send credentials to unexpected endpoints.",

  "permissions": ["activeTab", "webNavigation", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard"
  }
}
